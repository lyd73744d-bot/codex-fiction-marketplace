  "patternCatalog": [
    {
      "id": "H01",
      "sourceName": "过度强调意义、遗产和更广泛的趋势",
      "applicability": "active",
      "novelGuidance": "检查没有行动、后果或人物认知支撑的主题拔高；不删除作品真实承担的主题。"
    },
    {
      "id": "H02",
      "sourceName": "过度强调知名度和媒体报道",
      "applicability": "active",
      "novelGuidance": "检查正文中无情节功能的知名度或权威罗列；世界内确有来源时保留。"
    },
    {
      "id": "H03",
      "sourceName": "以 -ing 结尾的肤浅分析",
      "applicability": "adapted",
      "novelGuidance": "中文适配为句尾附加确保、彰显、象征、反映等无新证据的假分析。"
    },
    {
      "id": "H04",
      "sourceName": "宣传和广告式语言",
      "applicability": "active",
      "novelGuidance": "检查旁白中的广告腔；人物有意吹嘘或类型爽点有具体结果时不机械删除。"
    },
    {
      "id": "H05",
      "sourceName": "模糊归因和含糊措辞",
      "applicability": "active",
      "novelGuidance": "检查无来源的专家、众人和传闻归因；人物确实不知道来源时可作为有限视角。"
    },
    {
      "id": "H06",
      "sourceName": "提纲式的挑战与未来展望",
      "applicability": "active",
      "novelGuidance": "检查脱离场景的总结式展望，不把具体章尾悬念当成问题。"
    },
    {
      "id": "H07",
      "sourceName": "过度使用的 AI 高频词",
      "applicability": "active",
      "novelGuidance": "按同章密度和组合判断，不把单个常用词当禁词。"
    },
    {
      "id": "H08",
      "sourceName": "回避使用简单系动词",
      "applicability": "active",
      "novelGuidance": "检查为显得高级而绕写的空壳句，不强制所有句子改成是或有。"
    },
    {
      "id": "H09",
      "sourceName": "否定式排比",
      "applicability": "active",
      "novelGuidance": "按重复密度检查不是而是、不仅而且；人物有意强调时可保留。"
    },
    {
      "id": "H10",
      "sourceName": "三段式法则过度使用",
      "applicability": "active",
      "novelGuidance": "只检查强行凑齐的机械三项，不接受两项优于三项之类固定数量规则。"
    },
    {
      "id": "H11",
      "sourceName": "刻意换词（同义词循环）",
      "applicability": "active",
      "novelGuidance": "检查同一人物被机械换称谓造成距离和歧义；符合视角的称谓变化保留。"
    },
    {
      "id": "H12",
      "sourceName": "虚假范围",
      "applicability": "active",
      "novelGuidance": "检查从 X 到 Y 却没有共同尺度的空泛跨度。"
    },
    {
      "id": "H13",
      "sourceName": "破折号过度使用",
      "applicability": "active",
      "novelGuidance": "只以过度密度和万能停顿为证据，人物对白的打断、省略与抢话必须保留。"
    },
    {
      "id": "H14",
      "sourceName": "粗体过度使用",
      "applicability": "conditional",
      "novelGuidance": "只在正文含 Markdown 时检查机械强调；项目格式本身需要的标记不处理。"
    },
    {
      "id": "H15",
      "sourceName": "内联标题垂直列表",
      "applicability": "conditional",
      "novelGuidance": "只检查误入正文的答题式清单；系统面板、书信和有意排版不机械判定。"
    },
    {
      "id": "H16",
      "sourceName": "标题中的标题大写",
      "applicability": "conditional",
      "novelGuidance": "中文标题通常没有大小写问题，中文文本不机械判定；仅检查实际出现的外语标题。"
    },
    {
      "id": "H17",
      "sourceName": "表情符号",
      "applicability": "conditional",
      "novelGuidance": "检查误入叙事正文的装饰表情；聊天记录或项目要求的界面文本可保留。"
    },
    {
      "id": "H18",
      "sourceName": "弯引号",
      "applicability": "conditional",
      "novelGuidance": "中文弯引号和中文引号是正确排版；仅按项目既定引号格式检查混用与错位。"
    },
    {
      "id": "H19",
      "sourceName": "协作交流痕迹",
      "applicability": "active",
      "novelGuidance": "检查希望对你有帮助、请告诉我等模型对用户说话的残留。"
    },
    {
      "id": "H20",
      "sourceName": "知识截止日期免责声明",
      "applicability": "active",
      "novelGuidance": "删除误入正文的模型免责声明，但不得为了替换免责声明编造事实、日期或来源。"
    },
    {
      "id": "H21",
      "sourceName": "谄媚或卑躬屈膝的语气",
      "applicability": "active",
      "novelGuidance": "检查模型对作者的无信息讨好；角色因权力关系奉承不属于 AI 痕迹。"
    },
    {
      "id": "H22",
      "sourceName": "填充短语",
      "applicability": "active",
      "novelGuidance": "检查不推动动作、关系、信息或节奏的填充，不把人物犹豫和潜台词一概删掉。"
    },
    {
      "id": "H23",
      "sourceName": "过度限定",
      "applicability": "active",
      "novelGuidance": "检查层层可能与似乎造成的无意含糊；有限视角真实不确定时保留。"
    },
    {
      "id": "H24",
      "sourceName": "通用积极结论",
      "applicability": "active",
      "novelGuidance": "检查没有具体结果的乐观总结，不删除已有结果支撑的爽点结算。"
    }
  ],
  "novelPatternCatalog": [
    {
      "id": "N01",
      "name": "空洞宣告",
      "guidance": "没有行动、证据、代价或人物独特口吻支撑的算账、风暴、命运宣告。"
    },
    {
      "id": "N02",
      "name": "机械承接",
      "guidance": "与此同时、下一秒、紧接着、然而、话音刚落等连续充当段落发动机。"
    },
    {
      "id": "N03",
      "name": "万能情绪与模板反应",
      "guidance": "眼神一沉、嘴角一勾、心头一震、瞳孔骤缩等替代人物独有反应。"
    },
    {
      "id": "N04",
      "name": "解释型旁白",
      "guidance": "用这意味着、他明白、真正危机等总结动作和后果已经说明的内容。"
    },
    {
      "id": "N05",
      "name": "无信息碎段与空泛章尾",
      "guidance": "孤立的沉默、死寂、震动，或没有具体变化的下一场危机预告。"
    }
  ],
